# Copie este arquivo para .env e preencha com suas credenciais do Supabase
# Encontre esses valores em: https://supabase.com/dashboard -> seu projeto -> Settings -> API

SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua_anon_key_aqui

VITE_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua_anon_key_aqui
VITE_SUPABASE_PROJECT_ID=SEU_PROJECT_ID

# Pluggy (Meu Pluggy — integração bancária pessoal, https://pluggy.ai)
# Crie uma conta grátis em https://dashboard.pluggy.ai e gere Client ID/Secret
PLUGGY_CLIENT_ID=seu_client_id_aqui
PLUGGY_CLIENT_SECRET=seu_client_secret_aqui
